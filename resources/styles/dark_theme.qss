/* ============================================================
   MedAxis — Dark Theme
   Medical imaging platform stylesheet
   Palette:
     base:    #1e1e2e
     surface: #2d2d3f
     accent:  #3d3d5c
     text:    #e6e6f0
     dim:     #a0a0b8
     highlight: #5a5aff
     danger:  #ff5a6a
     success: #3ecf8e
   ============================================================ */

/* ---------- Global ---------- */
* {
    font-family: "Segoe UI", "Inter", "Noto Sans", sans-serif;
    font-size: 13px;
    color: #e6e6f0;
}

QWidget {
    background-color: #1e1e2e;
}

QToolTip {
    background-color: #2d2d3f;
    color: #e6e6f0;
    border: 1px solid #3d3d5c;
    padding: 4px 6px;
}

QLabel {
    background: transparent;
    color: #e6e6f0;
}

QLabel[role="dim"] {
    color: #a0a0b8;
}

/* ---------- Menu Bar & Menus ---------- */
QMenuBar {
    background-color: #232336;
    border-bottom: 1px solid #2d2d3f;
    padding: 2px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #3d3d5c;
}

QMenuBar::item:pressed {
    background-color: #4a4a73;
}

QMenu {
    background-color: #2d2d3f;
    border: 1px solid #3d3d5c;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 5px 24px 5px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #3d3d5c;
}

QMenu::item:disabled {
    color: #606078;
}

QMenu::separator {
    height: 1px;
    background: #3d3d5c;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
}

QMenu::indicator:checked {
    background: #5a5aff;
    border-radius: 3px;
}

/* ---------- Toolbars ---------- */
QToolBar {
    background-color: #232336;
    border: none;
    border-bottom: 1px solid #2d2d3f;
    padding: 3px;
    spacing: 3px;
}

QToolBar::separator {
    width: 1px;
    background: #3d3d5c;
    margin: 4px 6px;
}

QToolButton {
    background: transparent;
    border: none;
    border-radius: 5px;
    padding: 5px;
    color: #e6e6f0;
}

QToolButton:hover {
    background-color: #2d2d3f;
}

QToolButton:pressed {
    background-color: #3d3d5c;
}

QToolButton:checked {
    background-color: #3d3d5c;
    border: 1px solid #5a5aff;
}

QToolButton:disabled {
    color: #606078;
}

QToolButton::menu-indicator {
    image: none;
}

/* ---------- Dock Widgets ---------- */
QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    color: #e6e6f0;
}

QDockWidget::title {
    background-color: #232336;
    padding: 6px 10px;
    border-bottom: 1px solid #2d2d3f;
    text-align: left;
    font-weight: 600;
}

QDockWidget QWidget {
    background-color: #1e1e2e;
}

/* ---------- Tree Views (DICOM browser, label panel) ---------- */
QTreeView {
    background-color: #1e1e2e;
    alternate-background-color: #232336;
    border: 1px solid #2d2d3f;
    border-radius: 4px;
    selection-background-color: #3d3d5c;
    selection-color: #ffffff;
    outline: none;
}

QTreeView::item {
    padding: 3px;
    border: none;
}

QTreeView::item:hover {
    background-color: #2d2d3f;
}

QTreeView::item:selected {
    background-color: #3d3d5c;
    color: #ffffff;
}

QTreeView::branch {
    background: transparent;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: none;
    border-image: none;
}

QHeaderView::section {
    background-color: #232336;
    color: #a0a0b8;
    border: none;
    border-right: 1px solid #2d2d3f;
    border-bottom: 1px solid #2d2d3f;
    padding: 4px 8px;
    font-weight: 600;
}

QHeaderView::section:hover {
    background-color: #2d2d3f;
    color: #e6e6f0;
}

/* ---------- Table Views ---------- */
QTableView {
    background-color: #1e1e2e;
    alternate-background-color: #232336;
    border: 1px solid #2d2d3f;
    border-radius: 4px;
    gridline-color: #2d2d3f;
    selection-background-color: #3d3d5c;
    selection-color: #ffffff;
    outline: none;
}

QTableView::item:hover {
    background-color: #2d2d3f;
}

QTableView::item:selected {
    background-color: #3d3d5c;
    color: #ffffff;
}

QTableCornerButton::section {
    background-color: #232336;
    border: none;
}

/* ---------- List Views ---------- */
QListView {
    background-color: #1e1e2e;
    border: 1px solid #2d2d3f;
    border-radius: 4px;
    outline: none;
}

QListView::item:hover {
    background-color: #2d2d3f;
}

QListView::item:selected {
    background-color: #3d3d5c;
    color: #ffffff;
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: #2d2d3f;
    border: 1px solid #3d3d5c;
    border-radius: 5px;
    padding: 6px 14px;
    color: #e6e6f0;
}

QPushButton:hover {
    background-color: #3d3d5c;
    border-color: #5a5aff;
}

QPushButton:pressed {
    background-color: #4a4a73;
}

QPushButton:disabled {
    background-color: #232336;
    color: #606078;
    border-color: #2d2d3f;
}

QPushButton:default {
    background-color: #4a4a93;
    border-color: #5a5aff;
}

QPushButton:default:hover {
    background-color: #55559f;
}

QPushButton:default:disabled {
    background-color: #232336;
    color: #606078;
}

QPushButton[role="danger"] {
    background-color: #5c2d35;
    border-color: #ff5a6a;
}

QPushButton[role="danger"]:hover {
    background-color: #733a44;
}

/* ---------- Sliders ---------- */
QSlider::groove:horizontal {
    height: 4px;
    background: #2d2d3f;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #5a5aff;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #e6e6f0;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #ffffff;
}

QSlider::handle:horizontal:disabled {
    background: #606078;
}

QSlider::groove:vertical {
    width: 4px;
    background: #2d2d3f;
    border-radius: 2px;
}

QSlider::sub-page:vertical {
    background: #5a5aff;
    border-radius: 2px;
}

QSlider::handle:vertical {
    background: #e6e6f0;
    width: 14px;
    height: 14px;
    margin: 0 -5px;
    border-radius: 7px;
}

/* ---------- Spin Boxes ---------- */
QSpinBox, QDoubleSpinBox {
    background-color: #232336;
    border: 1px solid #2d2d3f;
    border-radius: 4px;
    padding: 3px 6px;
    selection-background-color: #3d3d5c;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #5a5aff;
}

QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: #606078;
    background-color: #1e1e2e;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #2d2d3f;
    border: none;
    width: 16px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #3d3d5c;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    width: 8px;
    height: 6px;
    background: #a0a0b8;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    width: 8px;
    height: 6px;
    background: #a0a0b8;
}

/* ---------- Line Edits & Text Edits ---------- */
QLineEdit {
    background-color: #232336;
    border: 1px solid #2d2d3f;
    border-radius: 4px;
    padding: 5px 8px;
    selection-background-color: #3d3d5c;
}

QLineEdit:focus {
    border-color: #5a5aff;
}

QLineEdit:disabled {
    color: #606078;
}

QTextEdit, QPlainTextEdit {
    background-color: #232336;
    border: 1px solid #2d2d3f;
    border-radius: 4px;
    selection-background-color: #3d3d5c;
}

/* ---------- Tab Widgets ---------- */
QTabWidget::pane {
    border: 1px solid #2d2d3f;
    border-radius: 4px;
    background-color: #1e1e2e;
    top: -1px;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background-color: #232336;
    color: #a0a0b8;
    border: 1px solid #2d2d3f;
    border-bottom: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding: 6px 14px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #2d2d3f;
    color: #e6e6f0;
}

QTabBar::tab:selected {
    background-color: #1e1e2e;
    color: #e6e6f0;
    border-bottom: 2px solid #5a5aff;
}

QTabBar::tab:disabled {
    color: #606078;
}

QTabBar::close-button {
    image: none;
    border-radius: 3px;
    padding: 2px;
}

QTabBar::close-button:hover {
    background-color: #3d3d5c;
}

/* ---------- Scroll Bars ---------- */
QScrollBar:horizontal {
    background: #1e1e2e;
    height: 12px;
    margin: 0;
}

QScrollBar:vertical {
    background: #1e1e2e;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal, QScrollBar::handle:vertical {
    background: #3d3d5c;
    border-radius: 5px;
    min-width: 24px;
    min-height: 24px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover, QScrollBar::handle:vertical:hover {
    background: #4a4a73;
}

QScrollBar::handle:pressed {
    background: #5a5aff;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ---------- Status Bar ---------- */
QStatusBar {
    background-color: #232336;
    border-top: 1px solid #2d2d3f;
    color: #a0a0b8;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #a0a0b8;
    padding: 0 8px;
}

/* ---------- Splitter ---------- */
QSplitter::handle {
    background-color: #2d2d3f;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}

QSplitter::handle:hover {
    background-color: #5a5aff;
}

/* ---------- Combo Boxes ---------- */
QComboBox {
    background-color: #232336;
    border: 1px solid #2d2d3f;
    border-radius: 4px;
    padding: 4px 8px;
    min-width: 80px;
}

QComboBox:hover {
    border-color: #3d3d5c;
}

QComboBox:focus {
    border-color: #5a5aff;
}

QComboBox:disabled {
    color: #606078;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #2d2d3f;
    border: 1px solid #3d3d5c;
    selection-background-color: #3d3d5c;
    selection-color: #ffffff;
    outline: none;
}

/* ---------- Check Boxes ---------- */
QCheckBox {
    background: transparent;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3d3d5c;
    border-radius: 4px;
    background-color: #232336;
}

QCheckBox::indicator:hover {
    border-color: #5a5aff;
}

QCheckBox::indicator:checked {
    background-color: #5a5aff;
    border-color: #5a5aff;
}

QCheckBox::indicator:disabled {
    border-color: #2d2d3f;
    background-color: #1e1e2e;
}

QCheckBox:disabled {
    color: #606078;
}

/* ---------- Radio Buttons ---------- */
QRadioButton {
    background: transparent;
    spacing: 6px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3d3d5c;
    border-radius: 8px;
    background-color: #232336;
}

QRadioButton::indicator:hover {
    border-color: #5a5aff;
}

QRadioButton::indicator:checked {
    background-color: #5a5aff;
    border-color: #5a5aff;
}

QRadioButton:disabled {
    color: #606078;
}

/* ---------- Group Boxes ---------- */
QGroupBox {
    border: 1px solid #2d2d3f;
    border-radius: 5px;
    margin-top: 10px;
    padding-top: 8px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #a0a0b8;
    background-color: #1e1e2e;
}

/* ---------- Progress Bars ---------- */
QProgressBar {
    background-color: #232336;
    border: 1px solid #2d2d3f;
    border-radius: 4px;
    text-align: center;
    color: #e6e6f0;
    height: 16px;
}

QProgressBar::chunk {
    background-color: #5a5aff;
    border-radius: 3px;
}

/* ---------- Dialogs ---------- */
QDialog {
    background-color: #1e1e2e;
}

QMessageBox {
    background-color: #1e1e2e;
}

/* ---------- Medical Image Viewports ----------
   Widgets assigned the object name or property "viewport" get a pure
   black background for accurate window/level display. */
QWidget#viewport,
QWidget[viewport="true"],
QOpenGLWidget,
QVTKOpenGLNativeWidget {
    background-color: #000000;
    border: none;
}

/* ---------- Scroll Areas around viewports ---------- */
QScrollArea {
    background: transparent;
    border: none;
}

QFrame[frameShape="4"], /* HLine */
QFrame[frameShape="5"]  /* VLine */
{
    color: #2d2d3f;
    max-height: 1px;
    max-width: 1px;
}
